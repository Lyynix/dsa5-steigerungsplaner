{{!--
    The planner tab on the character sheet: header with the AP summary, requests, then the planned
    steps by section. Context from sheet/tab.js, all fields prefixed with `planner`.
--~}}
<div class="tab steigerungsplaner-tab {{tabs.steigerungsplaner.cssClass}}{{#if plannerPhaseLocked}} planner-phase-locked{{/if}}" data-tab="steigerungsplaner" data-group="{{tabs.steigerungsplaner.group}}">
    <header class="planner-header">
        <h2>{{localize "STEIGERUNGSPLANER.Title"}}</h2>
        <a class="planner-add-target" data-plan-add-target data-tooltip="{{localize 'STEIGERUNGSPLANER.Tab.AddValueTooltip'}}">
            <i class="fas fa-plus"></i> {{localize "STEIGERUNGSPLANER.Tab.AddValue"}}
        </a>
        <a class="planner-add-request" data-plan-add-request data-tooltip="{{localize 'STEIGERUNGSPLANER.Catalog.ButtonTooltip'}}">
            <i class="fas fa-scroll"></i> {{localize "STEIGERUNGSPLANER.Catalog.Button"}}
        </a>
        <div class="planner-summary">
            <span>{{localize "STEIGERUNGSPLANER.Summary.Full" free=plannerAvailableXP planned=plannerTotalCost}}</span>
        </div>
    </header>

    {{#if plannerPhaseHint}}
    <p class="planner-phase-hint"><i class="fas fa-lock"></i> {{plannerPhaseHint}}</p>
    {{/if}}

    {{#if plannerRequests.length}}
    <div>
        <div class="row-section skills table-header lineheight steigerungsplaner-section-requests">
            <div class="col">{{localize "STEIGERUNGSPLANER.Section.requests"}}</div>
        </div>
        {{#each plannerRequests as |request|}}
        <div class="row-section wrap skills lineheight tableOdd planner-request{{#if request.unaffordable}} planner-request-unaffordable{{/if}}">
            {{#if request.img}}<img class="planner-group-icon" src="{{request.img}}" alt="">{{/if}}
            <div class="planner-request-label">
                {{request.label}}
                {{#if request.extensionMissing}}<i class="fas fa-triangle-exclamation planner-request-warning" data-tooltip="{{request.blockedReason}}"></i>{{/if}}
            </div>
            {{#if request.levels}}
            <span class="planner-request-levels{{#if request.requested}} locked{{/if}}" {{#if request.requested}}data-tooltip="{{localize 'STEIGERUNGSPLANER.Level.Locked'}}"{{/if}}>
                {{#each request.levels as |level|}}
                {{#if level.clickable}}
                <a class="planner-request-level{{#if level.selected}} selected{{/if}}" data-request-level="{{level.value}}" data-id="{{request.id}}" data-tooltip="{{level.tooltip}}">{{level.label}}</a>
                {{else}}
                <span class="planner-request-level{{#if level.owned}} owned{{/if}}{{#if level.selected}} selected{{/if}}"{{#unless request.requested}} data-tooltip="{{level.tooltip}}"{{/unless}}>{{level.label}}</span>
                {{/if}}
                {{/each}}
            </span>
            {{else if request.level}}
            <span class="planner-request-info">{{localize "STEIGERUNGSPLANER.Level.Numbered" level=request.levelLabel}}</span>
            {{/if}}
            {{#if request.fw}}
            <label class="planner-request-fw" data-tooltip="{{request.fw.tooltip}}">
                {{localize "STEIGERUNGSPLANER.TargetFW.Label"}} {{request.fw.start}} &rarr;
                <input type="number" data-request-fw data-id="{{request.id}}" value="{{request.fw.target}}" min="{{request.fw.start}}" step="1">
                {{#if request.fw.hint}}<span class="planner-request-fw-hint">{{request.fw.hint}}</span>{{/if}}
            </label>
            {{/if}}
            {{#if request.costUnknown}}
            <span class="planner-request-info planner-request-cost" data-tooltip="{{localize 'STEIGERUNGSPLANER.Cost.Unknown'}}">? AP</span>
            {{else}}
            <span class="planner-request-info planner-request-cost"{{#if request.unaffordable}} data-tooltip="{{localize 'STEIGERUNGSPLANER.Request.Unaffordable'}}"{{/if}}>{{request.cost}} AP</span>
            {{/if}}
            {{#if request.requested}}
            <span class="planner-request-info"><i class="fas fa-hourglass-half"></i> {{localize "STEIGERUNGSPLANER.Request.Pending"}}</span>
            {{else if request.rejected}}
            <span class="planner-request-info planner-request-rejected" data-tooltip="{{request.rejectedReason}}"><i class="fas fa-ban"></i> {{localize "STEIGERUNGSPLANER.Request.Rejected"}}</span>
            {{/if}}
            {{#if @root.plannerIsGM}}
            <a class="planner-approve" data-request-approve data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approval.Approve'}}">
                <i class="fas fa-check"></i>
            </a>
            <a class="planner-gift" data-request-gift data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approval.Gift'}}">
                <i class="fas fa-gift"></i>
            </a>
            {{else if request.requested}}
            <a class="planner-withdraw" data-request-withdraw data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Request.Withdraw'}}">
                <i class="fas fa-rotate-left"></i>
            </a>
            {{else if request.blockedReason}}
            <span class="planner-send planner-send-blocked" data-tooltip="{{request.blockedReason}}">
                <i class="fas fa-paper-plane"></i>
            </span>
            {{else}}
            <a class="planner-send" data-request-send data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Request.Send'}}">
                <i class="fas fa-paper-plane"></i>
            </a>
            {{/if}}
            <a class="planner-cancel" data-request-remove data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Request.Remove'}}">
                <i class="fas fa-trash"></i>
            </a>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#each plannerSections as |section|}}
    <div>
        <div class="row-section skills table-header lineheight {{section.cssClass}}">
            <div class="col">{{section.label}}</div>
        </div>
        <div class="row-section skills table-title">
            <div class="col third">{{localize "STEIGERUNGSPLANER.Tab.ColumnTarget"}}</div>
            <div class="col">{{localize "STEIGERUNGSPLANER.Tab.ColumnPlan"}}</div>
        </div>
        {{#each section.groups as |group|}}
        <div class="row-section wrap skills lineheight tableOdd" >
            {{#if group.icon}}<img class="planner-group-icon" src="{{group.icon}}" alt="">{{/if}}
            <div class="planner-group-label">{{group.label}}</div>
            <a class="planner-apply" data-plan-apply data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Plan.Apply'}}">
                <i class="fas fa-arrow-turn-left"></i>
            </a>
            <ol class="planner-steps">
                {{#each group.steps as |step|}}
                <li class="planner-step{{#if step.unaffordable}} planner-step-unaffordable{{/if}}">
                    <div class="planner-step-inner" data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Plan.ApplyStep'}}">
                        {{#if step.limit}}<i class="fas fa-triangle-exclamation planner-limit planner-limit-{{step.limit}}" data-tooltip="{{step.limitHint}}"></i>{{/if}}
                        <span class="planner-step-values">{{step.from}} &raquo; {{step.to}}</span>
                        <span class="planner-step-cost">{{step.cost}} AP</span>
                        <a class="planner-step-remove" data-type="{{group.type}}" data-key="{{group.key}}" data-id="{{step.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Plan.RemoveStep'}}">
                            <i class="fas fa-xmark"></i>
                        </a>
                    </div>
                </li>
                {{/each}}
            </ol>
            <a class="planner-add" data-plan-add data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Plan.AddStep'}}">
                <i class="fas fa-square-plus"></i>
            </a>
            <a class="planner-cancel" data-plan-cancel data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Plan.DiscardAll'}}">
                <i class="fas fa-trash"></i>
            </a>
        </div>
        {{/each}}
    </div>
    {{/each}}

    {{#if plannerEmpty}}
    <p class="planner-empty">{{localize "STEIGERUNGSPLANER.Tab.Empty"}}</p>
    {{/if}}
</div>
