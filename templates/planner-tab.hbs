<div class="tab steigerungsplaner-tab {{tabs.steigerungsplaner.cssClass}}" data-tab="steigerungsplaner" data-group="{{tabs.steigerungsplaner.group}}">
    <header class="planner-header">
        <h2>{{localize "STEIGERUNGSPLANER.Tab"}}</h2>
        <div class="planner-summary">
            <span>{{localize "STEIGERUNGSPLANER.AvailableXP"}}: {{plannerAvailableXP}}</span>
            <span>{{localize "STEIGERUNGSPLANER.TotalCost"}}: {{plannerTotalCost}}</span>
        </div>
    </header>

    {{#if plannerSections.length}}
    {{#each plannerSections as |section|}}
    <div class="planner-section">
        <div class="planner-section-header {{section.cssClass}}">{{section.label}}</div>
        <ul class="planner-groups">
            {{#each section.groups as |group|}}
            <li class="planner-group">
                <a class="planner-apply" data-plan-apply data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Apply'}}">
                    <i class="fas fa-arrow-turn-left"></i>
                </a>
                <div class="planner-group-label">{{group.label}}</div>
                <ol class="planner-steps">
                    {{#each group.steps as |step|}}
                    <li class="planner-step">
                        <span class="planner-step-values">{{step.from}} &raquo; {{step.to}}</span>
                        <span class="planner-step-cost">{{step.cost}} AP</span>
                    </li>
                    {{/each}}
                </ol>
                <a class="planner-cancel" data-plan-cancel data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Cancel'}}">
                    <i class="fas fa-trash"></i>
                </a>
            </li>
            {{/each}}
        </ul>
    </div>
    {{/each}}
    {{else}}
    <p class="planner-empty">{{localize "STEIGERUNGSPLANER.Empty"}}</p>
    {{/if}}
</div>
