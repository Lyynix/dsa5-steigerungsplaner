<div class="tab steigerungsplaner-tab {{tabs.steigerungsplaner.cssClass}}" data-tab="steigerungsplaner" data-group="{{tabs.steigerungsplaner.group}}">
    <header class="planner-header">
        <h2>{{localize "STEIGERUNGSPLANER.Tab"}}</h2>
        <a class="planner-add-target" data-plan-add-target>
            <i class="fas fa-plus"></i> {{localize "STEIGERUNGSPLANER.AddTarget"}}
        </a>
        <a class="planner-add-request" data-plan-add-request data-tooltip="{{localize 'STEIGERUNGSPLANER.AddRequestTooltip'}}">
            <i class="fas fa-scroll"></i> {{localize "STEIGERUNGSPLANER.AddRequest"}}
        </a>
        <div class="planner-summary">
            <span>{{localize "STEIGERUNGSPLANER.AvailableXP"}}: {{plannerAvailableXP}}</span>
            <span>{{localize "STEIGERUNGSPLANER.TotalCost"}}: {{plannerTotalCost}}</span>
        </div>
    </header>

    {{#if plannerRequests.length}}
    <div>
        <div class="row-section skills table-header lineheight steigerungsplaner-section-requests">
            <div class="col">{{localize "STEIGERUNGSPLANER.Section.requests"}}</div>
        </div>
        {{#each plannerRequests as |request|}}
        <div class="row-section wrap skills lineheight tableOdd planner-request">
            {{#if request.img}}<img class="planner-group-icon" src="{{request.img}}" alt="">{{/if}}
            <div class="planner-request-label">{{request.label}}</div>
            {{#if request.level}}
            <span class="planner-request-info">{{localize "STEIGERUNGSPLANER.RequestLevel" level=request.level}}</span>
            {{/if}}
            {{#if request.requested}}
            <span class="planner-request-info"><i class="fas fa-hourglass-half"></i> {{localize "STEIGERUNGSPLANER.RequestPending"}}</span>
            <a class="planner-withdraw" data-request-withdraw data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.RequestWithdraw'}}">
                <i class="fas fa-rotate-left"></i>
            </a>
            {{else}}
            <a class="planner-send" data-request-send data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.RequestSend'}}">
                <i class="fas fa-paper-plane"></i>
            </a>
            {{/if}}
            <a class="planner-cancel" data-request-remove data-id="{{request.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.RequestRemove'}}">
                <i class="fas fa-trash"></i>
            </a>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#each plannerSections as |section|}}
    <div>
        <div class="row-section skills table-header lineheight {{section.cssClass}}">
            <div class="col">{{section.label}}</div>
        </div>
        <div class="row-section skills table-title">
            <div class="col third">{{localize "STEIGERUNGSPLANER.ColumnTarget"}}</div>
            <div class="col">{{localize "STEIGERUNGSPLANER.ColumnPlan"}}</div>
        </div>
        {{#each section.groups as |group|}}
        <div class="row-section wrap skills lineheight tableOdd" >
            {{#if group.icon}}<img class="planner-group-icon" src="{{group.icon}}" alt="">{{/if}}
            <div class="planner-group-label">{{group.label}}</div>
            <a class="planner-apply" data-plan-apply data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Apply'}}">
                <i class="fas fa-arrow-turn-left"></i>
            </a>
            <ol class="planner-steps">
                {{#each group.steps as |step|}}
                <li class="planner-step{{#if step.unaffordable}} planner-step-unaffordable{{/if}}">
                    <div class="planner-step-inner" data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.ApplyStep'}}">
                        <span class="planner-step-values">{{step.from}} &raquo; {{step.to}}</span>
                        <span class="planner-step-cost">{{step.cost}} AP</span>
                        <a class="planner-step-remove" data-type="{{group.type}}" data-key="{{group.key}}" data-id="{{step.id}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.RemoveStep'}}">
                            <i class="fas fa-xmark"></i>
                        </a>
                    </div>
                </li>
                {{/each}}
            </ol>
            <a class="planner-add" data-plan-add data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.AddStep'}}">
                <i class="fas fa-square-plus"></i>
            </a>
            <a class="planner-cancel" data-plan-cancel data-type="{{group.type}}" data-key="{{group.key}}" data-tooltip="{{localize 'STEIGERUNGSPLANER.Cancel'}}">
                <i class="fas fa-trash"></i>
            </a>
        </div>
        {{/each}}
    </div>
    {{/each}}

    {{#if plannerEmpty}}
    <p class="planner-empty">{{localize "STEIGERUNGSPLANER.Empty"}}</p>
    {{/if}}
</div>
