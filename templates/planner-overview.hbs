{{!--
    The GM's overview: toolbar, then per character the open requests and the plan by section.
    Context from overview.js.
--~}}
<div class="overview">
    <div class="overview-toolbar">
        <label class="overview-filter">
            <input type="checkbox" data-only-open {{#if onlyOpen}}checked{{/if}}>
            {{localize "STEIGERUNGSPLANER.Overview.OnlyOpen"}}
        </label>
        {{#if phase}}
        <button type="button" class="overview-phase{{#if phase.open}} open{{/if}}" data-action="togglePhase" data-tooltip="{{localize (ifThen phase.open 'STEIGERUNGSPLANER.Phase.CloseTooltip' 'STEIGERUNGSPLANER.Phase.OpenTooltip')}}">
            <i class="fas {{#if phase.open}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
            {{localize (ifThen phase.open 'STEIGERUNGSPLANER.Phase.IsOpen' 'STEIGERUNGSPLANER.Phase.IsClosed')}}
        </button>
        {{/if}}
    </div>

    {{#each actors as |actor|}}
    <section class="overview-actor{{#if actor.collapsed}} collapsed{{/if}}" data-actor-id="{{actor.id}}">
        <header class="overview-actor-header">
            <a class="overview-toggle" data-action="toggleActor"><i class="fas {{#if actor.collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i></a>
            <img src="{{actor.img}}" alt="" onerror="this.onerror = null; this.src = 'icons/svg/mystery-man.svg';">
            <h2 class="overview-actor-name"><a data-action="openSheet" data-tooltip="{{localize 'STEIGERUNGSPLANER.Overview.OpenSheet'}}">{{actor.name}}</a></h2>
            <span class="overview-summary">{{actor.free}} · <span class="{{#if actor.overBudget}}over-budget{{/if}}">{{actor.planned}}</span></span>
        </header>

        {{!-- Waiting for the GM - shown even with the character collapsed. --}}
        {{#if actor.openRequests.length}}
        <div class="overview-requests">
            <div class="overview-requests-title"><i class="fas fa-envelope"></i> {{localize "STEIGERUNGSPLANER.Overview.OpenRequests"}}</div>
            {{#each actor.openRequests as |request|}}
            <div class="overview-request" data-request-id="{{request.id}}">
                {{#if request.img}}<img class="overview-icon" src="{{request.img}}" alt="">{{/if}}
                <span class="overview-name">{{{request.link}}}</span>
                {{#if request.level}}<span class="overview-chip">{{request.level}}</span>{{/if}}
                {{#if request.costUnknown}}
                <span class="overview-cost" data-tooltip="{{localize 'STEIGERUNGSPLANER.Cost.Unknown'}}">? AP</span>
                {{else}}
                <span class="overview-cost">{{request.cost}} AP</span>
                {{/if}}
                <button type="button" class="overview-approve" data-action="approve" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approval.Approve'}}"><i class="fas fa-check"></i> {{localize "STEIGERUNGSPLANER.Approval.ApproveShort"}}</button>
                <button type="button" class="overview-gift" data-action="gift" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approval.Gift'}}"><i class="fas fa-gift"></i></button>
                <button type="button" class="overview-reject" data-action="reject" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approval.Reject'}}"><i class="fas fa-ban"></i></button>
                {{#if request.requirements}}
                <div class="overview-requirements"><strong>{{localize "STEIGERUNGSPLANER.Catalog.Requirements"}}:</strong> {{request.requirements}}</div>
                {{/if}}
            </div>
            {{/each}}
        </div>
        {{/if}}

        {{#unless actor.collapsed}}
        <div class="overview-sections">
        {{#each actor.sections as |section|}}
        <div class="overview-section skills {{section.cssClass}}">
            <div class="overview-section-label">{{section.label}}</div>
            <div class="overview-tiles">
                {{#each section.entries as |entry|}}
                <span class="overview-tile">
                    {{#if entry.img}}<img class="overview-icon" src="{{entry.img}}" alt="">{{/if}}
                    <span class="overview-name">{{entry.label}}</span>
                    {{#if entry.detail}}<span class="overview-detail">{{entry.detail}}</span>{{/if}}
                    {{#if entry.limit}}<i class="fas fa-triangle-exclamation planner-limit planner-limit-{{entry.limit.limit}}" data-tooltip="{{entry.limit.hint}}"></i>{{/if}}
                    {{#if entry.rejected}}<span class="overview-rejected" data-tooltip="{{localize 'STEIGERUNGSPLANER.Request.Rejected'}}"><i class="fas fa-ban"></i></span>{{/if}}
                    <span class="overview-cost">{{entry.cost}}</span>
                </span>
                {{/each}}
            </div>
        </div>
        {{/each}}
        </div>
        {{/unless}}
    </section>
    {{else}}
    <p class="overview-empty">{{empty}}</p>
    {{/each}}
</div>
