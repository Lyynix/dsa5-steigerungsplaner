<div class="overview">
    <label class="overview-filter">
        <input type="checkbox" data-only-open {{#if onlyOpen}}checked{{/if}}>
        {{localize "STEIGERUNGSPLANER.OverviewOnlyOpen"}}
    </label>

    {{#each actors as |actor|}}
    <section class="overview-actor{{#if actor.collapsed}} collapsed{{/if}}" data-actor-id="{{actor.id}}">
        <header class="overview-actor-header">
            <a class="overview-toggle" data-action="toggleActor"><i class="fas {{#if actor.collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i></a>
            <img src="{{actor.img}}" alt="">
            <a class="overview-actor-name" data-action="openSheet" data-tooltip="{{localize 'STEIGERUNGSPLANER.OverviewOpenSheet'}}">{{actor.name}}</a>
            {{#if actor.openRequests.length}}<span class="overview-badge" data-tooltip="{{localize 'STEIGERUNGSPLANER.OverviewOpenRequests'}}"><i class="fas fa-envelope"></i> {{actor.openRequests.length}}</span>{{/if}}
            <span class="overview-summary">{{actor.summary}}</span>
        </header>

        {{#unless actor.collapsed}}
        {{#if actor.openRequests.length}}
        <ol class="overview-requests">
            {{#each actor.openRequests as |request|}}
            <li class="overview-request" data-request-id="{{request.id}}">
                <div class="overview-row">
                    {{#if request.img}}<img src="{{request.img}}" alt="">{{/if}}
                    <span class="overview-name">{{{request.link}}}</span>
                    {{#if request.level}}<span class="overview-info">{{localize "STEIGERUNGSPLANER.RequestLevel" level=request.level}}</span>{{/if}}
                    {{#if request.costUnknown}}
                    <span class="overview-info overview-cost" data-tooltip="{{localize 'STEIGERUNGSPLANER.CostUnknown'}}">? AP</span>
                    {{else}}
                    <span class="overview-info overview-cost">{{request.cost}} AP</span>
                    {{/if}}
                    <a class="overview-approve" data-action="approve" data-tooltip="{{localize 'STEIGERUNGSPLANER.Approve'}}"><i class="fas fa-check"></i></a>
                    <a class="overview-reject" data-action="reject" data-tooltip="{{localize 'STEIGERUNGSPLANER.Reject'}}"><i class="fas fa-ban"></i></a>
                </div>
                {{#if request.requirements}}
                <p class="overview-requirements"><strong>{{localize "STEIGERUNGSPLANER.Requirements"}}:</strong> {{request.requirements}}</p>
                {{/if}}
            </li>
            {{/each}}
        </ol>
        {{/if}}

        {{#if actor.planned.length}}
        <h4 class="overview-planned-label">{{localize "STEIGERUNGSPLANER.OverviewPlanned"}}</h4>
        <ol class="overview-planned">
            {{#each actor.planned as |entry|}}
            <li class="overview-row">
                {{#if entry.img}}<img src="{{entry.img}}" alt="">{{/if}}
                <span class="overview-name">
                    {{#if entry.request}}<i class="fas fa-scroll overview-request-icon" data-tooltip="{{localize 'STEIGERUNGSPLANER.OverviewFromCatalog'}}"></i>{{/if}}
                    {{entry.label}}
                    {{#if entry.rejected}}<span class="overview-rejected">{{localize "STEIGERUNGSPLANER.RequestRejected"}}</span>{{/if}}
                </span>
                {{#if entry.detail}}<span class="overview-info">{{entry.detail}}</span>{{/if}}
                <span class="overview-info overview-cost">{{entry.cost}}</span>
            </li>
            {{/each}}
        </ol>
        {{/if}}
        {{/unless}}
    </section>
    {{else}}
    <p class="overview-empty">{{empty}}</p>
    {{/each}}
</div>
